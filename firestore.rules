rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function accountUser() { return request.auth != null && request.auth.token.firebase.sign_in_provider in ['google.com', 'password']; }
    function owner(uid) { return accountUser() && request.auth.uid == uid; }
    function summary(s) {
      return s.keys().hasOnly(['totalRolls','strongestPower','timeTrialRoom','uniqueCards','displayName'])
        && s.totalRolls is int && s.totalRolls >= 0 && s.totalRolls <= 9007199254740991
        && s.strongestPower is int && s.strongestPower >= 0 && s.strongestPower <= 9007199254740991
        && s.timeTrialRoom is int && s.timeTrialRoom >= 0 && s.timeTrialRoom <= 9007199254740991
        && s.uniqueCards is int && s.uniqueCards >= 0 && s.uniqueCards <= 10000
        && s.displayName is string && s.displayName.size() > 0 && s.displayName.size() <= 40;
    }
    function saveBody(d) {
      return d.keys().hasOnly(['format','revision','digest','payload','manifest','summary','updatedAt'])
        && d.format == 'anime-card-cloud-v1' && d.revision is int && d.revision > 0
        && d.digest is string && d.digest.matches('^[a-f0-9]{64}$')
        && summary(d.summary) && d.updatedAt == request.time
        && d.payload is string && d.payload.size() > 0 && d.payload.size() <= 90000 && d.manifest == null;
    }
    match /users/{uid} {
      allow get: if owner(uid);
      allow list, delete: if false;
      allow create: if owner(uid) && saveBody(request.resource.data) && request.resource.data.revision == 1;
      allow update: if owner(uid) && saveBody(request.resource.data) && request.resource.data.revision == resource.data.revision + 1;
      match /snapshots/{snapshot}/chunks/{chunk} {
        // Keep legacy chunks readable during migration. New clients never write or delete them.
        allow get, list: if owner(uid);
        allow create, update, delete: if false;
      }
      match /recovery/{name} {
        allow get: if owner(uid) && name == 'previous';
        allow create, update, list, delete: if false;
      }
    }
    match /leaderboards/{uid} {
      allow get: if accountUser();
      allow list: if accountUser() && request.query.limit != null && request.query.limit <= 50;
      allow delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['uid','displayName','totalRolls','strongestPower','timeTrialRoom','uniqueCards','revision','updatedAt'])
        && request.resource.data.uid == uid && request.resource.data.updatedAt == request.time
        && request.resource.data.revision == getAfter(/databases/$(database)/documents/users/$(uid)).data.revision
        && request.resource.data.displayName == getAfter(/databases/$(database)/documents/users/$(uid)).data.summary.displayName
        && request.resource.data.totalRolls == getAfter(/databases/$(database)/documents/users/$(uid)).data.summary.totalRolls
        && request.resource.data.strongestPower == getAfter(/databases/$(database)/documents/users/$(uid)).data.summary.strongestPower
        && request.resource.data.timeTrialRoom == getAfter(/databases/$(database)/documents/users/$(uid)).data.summary.timeTrialRoom
        && request.resource.data.uniqueCards == getAfter(/databases/$(database)/documents/users/$(uid)).data.summary.uniqueCards;
    }
    match /infinity_leaderboards/{week} {
      function validEntry(d) {
        let row = d[request.auth.uid];
        return row is map && row.keys().hasOnly(['displayName','highestWave','updatedAt'])
          && row.displayName is string && row.displayName.size() > 0 && row.displayName.size() <= 40
          && row.highestWave is int && row.highestWave > 0 && row.highestWave <= 90071992547409
          && row.updatedAt == request.time;
      }
      function validWeek() { return week.matches('^[0-9]{4}_W(0[1-9]|[1-4][0-9]|5[0-3])$'); }
      allow get: if accountUser();
      allow list, delete: if false;
      allow create: if accountUser() && validWeek()
        && request.resource.data.keys().hasOnly([request.auth.uid]) && validEntry(request.resource.data);
      allow update: if accountUser() && validWeek() && validEntry(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in resource.data)
          || request.resource.data[request.auth.uid].highestWave >= resource.data[request.auth.uid].highestWave);
    }
    // Public replay snapshots; one own document overwritten at the end of a run.
    match /autochess_runs/{uid} {
      function rankFor(elo) { return elo >= 3300 ? 9 : elo >= 3100 ? 8 : elo >= 2800 ? 7 : elo >= 2400 ? 6 : elo >= 2000 ? 5 : elo >= 1600 ? 4 : elo >= 1200 ? 3 : elo >= 800 ? 2 : elo >= 400 ? 1 : 0; }
      function profileFields(d) {
        return ((!('rank' in d) && !('tier' in d) && !('division' in d) && !('avatar' in d)) || (d.rank is int && d.rank == rankFor(d.elo)
          && d.tier == ['iron','bronze','silver','gold','platinum','emerald','diamond','master','grandmaster','challenger'][d.rank]
          && d.division in ['', 'I', 'II', 'III', 'IV']
          && d.avatar == 'assets/items/' + d.tier + '.png'))
          && (!('bannerCardId' in d) || d.bannerCardId == null || (d.bannerCardId is string && d.bannerCardId.size() <= 100))
          && ((!('peakElo' in d) && !('peakRank' in d)) || (d.peakElo is int && d.peakElo >= d.elo && d.peakElo <= 9007199254740991
            && d.peakRank is string && d.peakRank.size() > 0 && d.peakRank.size() <= 40));
      }
      function validRun(d) {
        return d.keys().hasOnly(['version','codec','storageCodec','uid','name','matchId','placement','elo','rank','tier','division','avatar','bannerCardId','peakElo','peakRank','wins','matches','rounds','sampled','cards','relics','boards','augments','stages','updatedAt'])
          && d.version == 1 && d.codec == 'ac-run-1' && d.uid == uid
          && (!('storageCodec' in d) || d.storageCodec == 'ac-flat-1')
          && d.name is string && d.name.size() > 0 && d.name.size() <= 40
          && d.matchId is string && d.matchId.size() > 0 && d.matchId.size() <= 80
          && d.placement is int && d.placement >= 1 && d.placement <= 8
          && d.elo is int && d.elo >= 0 && d.elo <= 9007199254740991
          && d.wins is int && d.wins >= 0 && d.wins <= 9007199254740991
          && (!('matches' in d) || (d.matches is int && d.matches >= d.wins && d.matches <= 9007199254740991))
          && d.rounds is int && d.rounds > 0 && d.rounds <= 600 && d.sampled is bool
          && d.cards is list && d.cards.size() <= 1000
          && d.relics is list && d.relics.size() <= 64
          && d.boards is list && d.boards.size() > 0 && d.boards.size() <= 600
          && d.augments is list && d.augments.size() <= 16
          && d.stages is map && d.stages.size() > 0 && d.stages.size() <= 600
          && d.updatedAt == request.time && profileFields(d);
      }
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit != null && request.query.limit <= 50;
      allow create, update: if owner(uid) && validRun(request.resource.data);
      allow delete: if owner(uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
